# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Apenas a chave PUBLICAVEL entra no app (spec §21.4).
EXPO_PUBLIC_FLY_ENVIRONMENT=local
EXPO_PUBLIC_FLY_SUPABASE_URL=
EXPO_PUBLIC_FLY_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_FLY_APP_VERSION=0.1.0
# Injetado pela esteira de build; deixe vazio localmente.
EXPO_PUBLIC_FLY_COMMIT_SHA=

# Trip Mode — release da viagem (Dubai, set/2026).
# "true" liga a navegação de quatro abas e o suporte por WhatsApp.
# Ausente ou qualquer outro valor = o Fly App completo, como sempre.
EXPO_PUBLIC_FLY_TRIP_MODE=
# Rede de segurança do WhatsApp da operação. `app_config['support.whatsapp']`
# tem precedência; este valor existe para o dia em que a migration ainda não
# foi aplicada.
EXPO_PUBLIC_FLY_SUPPORT_WHATSAPP=
